# ─────────────────────────────────────────────────────────────────
#  PoopTunes — Environment Configuration
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# Port exposed on the host machine (e.g. 8080 → http://your-server:8080)
HOST_PORT=3005

# Maximum MP3 upload size in megabytes (default 200)
UPLOAD_LIMIT_MB=200
